#include "Shared.xcconfig"
// Staging = release candidate on the production backend.
#include "Backend-Prod.xcconfig"

APP_ENV = staging
APP_BUNDLE_IDENTIFIER = com.iletai.offrecord.staging
APP_DISPLAY_NAME = OffRecord Stg
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Staging
CODE_SIGN_ENTITLEMENTS = Config/Entitlements/OffRecord-Staging.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
// The Staging ASC record owns no subscriptions yet (only the Prod record does), so this stays empty:
// a group id here would query products under the Staging bundle id and return none. Dev tests purchases
// against App/StoreKit/Products.storekit; Staging paywall verification waits for products on its record.
SUBSCRIPTION_GROUP_ID =
